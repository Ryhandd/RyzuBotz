# ============================================================
#  RyzuBotz — Environment Configuration
#  Salin file ini menjadi .env lalu isi nilainya.
#  JANGAN commit file .env ke Git.
# ============================================================

# ---------- WAJIB ----------
# Token bot Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=MASUKKAN_TOKEN_DISCORD_BOT_DISINI

# Prefix perintah teks
PREFIX=.

# ---------- WEB SERVER (health check / UptimeRobot) ----------
# Port web server. Default 3000.
PORT=3000
# Host listen. 0.0.0.0 agar bisa diakses publik (hosting).
HOST=0.0.0.0

# ---------- AUDIO / MUSIK ----------
# Klien YouTube yang dicoba berurutan (dipisah koma).
# YTMUSIC & WEB memberi audio terbaik (opus itag 251, ~137 kbps).
YT_CLIENT=YTMUSIC,WEB,IOS
# Direktori cache audio sementara (file .ogg hasil remux).
MUSIC_CACHE_DIR=./cache/music
# Batas ukuran cache dalam MB (eviksi otomatis file terlama).
MUSIC_CACHE_MAX_MB=1500
# Set 0 untuk mematikan cache (selalu streaming).
MUSIC_CACHE=1
# Batas waktu resolve metadata (ms)
MUSIC_RESOLVE_TIMEOUT_MS=20000
# Batas waktu unduh audio (ms)
MUSIC_DOWNLOAD_TIMEOUT_MS=120000

# ---------- BATAS RESOURCE ----------
# Maksimal lagu dalam antrean per guild
MAX_QUEUE_SIZE=100
# Maksimal jumlah queue guild aktif (eviksi LRU)
MAX_GUILD_QUEUES=200

# ---------- LOGGING ----------
# error | warn | info | debug
LOG_LEVEL=info

# ---------- LAIN-LAIN (opsional, tidak dipakai kode saat ini) ----------
# ONEPUNYA_KEY=
# BETABOTZ_KEY=
# BETA_KEY=
